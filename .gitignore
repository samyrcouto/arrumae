# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# local uploaded files (dev storage adapter)
/storage/*
!/storage/.gitkeep

# playwright
/test-results/
/playwright-report/
.test-storage/
.e2e-storage/

# vitrine estática gerada (publicada no branch gh-pages)
/vitrine/

# Pasta de trabalho da skill design-taste-frontend (capturas e relatórios)
.taste-skill/
