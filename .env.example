# ---------------------------------------------------------------------------
# Arrumaê — variáveis de ambiente. Copie para .env.local e preencha.
# NUNCA coloque segredos reais neste arquivo.
# ---------------------------------------------------------------------------

# Ambiente lógico: development | test | staging | production
# Em "production" o seed de demonstração é bloqueado e o banner de demo some.
APP_ENV=development

# URL pública da aplicação (usada em links de e-mail e metadados)
APP_URL=http://localhost:3000

# PostgreSQL (local, Supabase, Neon, RDS...). Em produção use SSL.
DATABASE_URL=postgres://arrumae:arrumae_dev@localhost:5432/arrumae_dev
# Banco usado pelos testes de integração (será LIMPO a cada execução)
TEST_DATABASE_URL=postgres://arrumae:arrumae_dev@localhost:5432/arrumae_test

# Segredo para HMAC de IPs/ids anônimos em logs e rate limit (>= 32 caracteres aleatórios)
APP_SECRET=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres

# Armazenamento de arquivos: "local" (disco, apenas dev) | "s3" (planejado)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# E-mail: "console" (registra no log + tabela outbound_messages) | "smtp"/"resend" (planejado)
EMAIL_DRIVER=console
EMAIL_FROM="Arrumaê <nao-responda@exemplo.com.br>"

# Pagamentos: "offline" (piloto: pagamento direto ao profissional, sem cobrança pela plataforma)
# Provedores reais (asaas | mercadopago) ainda NÃO estão implementados.
PAYMENT_PROVIDER=offline

# Conta administradora inicial criada por `npm run db:create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Segredo para a rota POST /api/cron/maintenance (>= 32 caracteres). Sem ele a rota responde 503.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Integrações (n8n etc.) — ver docs/AUTOMACOES.md. Tudo opcional.
# ---------------------------------------------------------------------------
# Para onde enviar os eventos (webhook do n8n). Em produção precisa ser https.
INTEGRATION_WEBHOOK_URL=
# Segredo para assinar os eventos (HMAC). >= 32 caracteres; o mesmo vai no workflow do n8n.
INTEGRATION_WEBHOOK_SECRET=
# Token da API somente leitura GET /api/integrations/v1/metrics (>= 32 caracteres). Vazio = API desligada.
INTEGRATION_API_TOKEN=
