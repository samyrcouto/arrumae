{
  "name": "Arrumaê — 03 agendador da manutenção",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "c52c71fa-f630-5e1b-af59-1e7ee777d99e",
      "name": "A cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://SEU-APP/api/cron/maintenance",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "id": "7a0de027-0a0a-5de4-b4d4-657a5950b417",
      "name": "Rodar manutenção",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "da2a0d0a-440b-51d3-b81a-efc0c59e8c9f",
              "leftValue": "={{ $json.failures > 0 || $json.integrations.failed > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0b835703-4aa9-59a1-996d-50666358eecd",
      "name": "Teve falha?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nreturn [{ json: { mensagem: `⚠️ Manutenção do Arrumaê com falhas: ${r.failures} rotina(s) de pedido e ${r.integrations.failed} evento(s) de integração. Ver /admin/integracoes.` } }];"
      },
      "id": "87597d39-66ca-5152-a6fc-b04443f93be0",
      "name": "Montar aviso de falha",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        280
      ]
    },
    {
      "parameters": {
        "chatId": "COLE_AQUI_O_ID_DO_GRUPO_DA_EQUIPE",
        "text": "={{ $json.mensagem }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "ec75c402-8b3e-53a5-8ce6-00a9399c280c",
      "name": "Enviar para a equipe (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        280
      ]
    }
  ],
