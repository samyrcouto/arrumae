{
  "name": "arrumae",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:migrate:test": "tsx --conditions=react-server scripts/migrate.ts --test",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:create-admin": "tsx --conditions=react-server scripts/create-admin.ts",
    "db:encrypt-pii": "tsx --conditions=react-server scripts/encrypt-pii.ts",
    "db:reset-2fa": "tsx --conditions=react-server scripts/reset-2fa.ts",
    "jobs": "tsx --conditions=react-server scripts/jobs.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node tests/e2e/run.mjs",
    "vitrine": "node tests/e2e/run.mjs --vitrine",
    "vitrine:publicar": "node scripts/publicar-vitrine.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
